<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Mac App Store / TestFlight builds must be sandboxed. Local prod installs keep the
	     non-sandboxed BananaMac.entitlements so existing on-disk data stays reachable;
	     sandboxed builds get a fresh container. iCloud IS included: the Mac app now shares
	     com.boris.banana, whose App ID already carries the container associations. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(BANANA_ICLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>$(BANANA_ICLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.boris.banana</string>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Find meal photos automatically: reading the Photos library, only once turned on. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- The LAN podcast-file peer service (Bonjour _banana-audio._tcp) both serves and browses. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- There is NO personal-information.reminders key on macOS: the App Store validator
	     rejects it outright ("not supported on macOS"). EventKit reminders on a sandboxed Mac
	     build are covered by the calendars entitlement above plus
	     NSRemindersFullAccessUsageDescription. Do not add one back. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Voice notes. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<!-- Silent pushes from the Banana service when a Google calendar changes (docs/design/ACCOUNTS.md). -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
