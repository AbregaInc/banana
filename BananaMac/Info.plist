<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BananaCloudContainer</key>
	<string>$(BANANA_ICLOUD_CONTAINER)</string>
	<key>BananaGoogleServerClient</key>
	<string>$(BANANA_GOOGLE_SERVER_CLIENT)</string>
	<key>BananaLegacyCloudContainer</key>
	<string>$(BANANA_LEGACY_ICLOUD_CONTAINER)</string>
	<key>BananaPrivateCloudCompute</key>
	<false/>
	<key>BananaServiceHost</key>
	<string>$(BANANA_SERVICE_HOST)</string>
	<key>BananaTeamID</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Banana</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.$(BANANA_GOOGLE_CLIENT)</string>
				<string>banananote</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GIDClientID</key>
	<string>$(BANANA_GOOGLE_CLIENT).apps.googleusercontent.com</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Banana plays a playlist, album, or song from your Apple Music library when a routine starts.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_banana-audio._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Banana uses the camera only when you choose to photograph a meal or a supplement label, or scan a barcode.</string>
	<key>NSContactsUsageDescription</key>
	<string>Banana looks up the people you type when adding guests to an event, so “Lunch with Sam” can invite the Sam you mean.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Banana reads your workouts and health metrics from Apple Health so it can show and analyze your fitness in one place.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Banana saves workouts to Apple Health and updates them when you trim a workout.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Banana finds your other Banana devices on this Wi-Fi so one downloaded podcast file can be reused without downloading it again.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Banana uses your location for your local forecast.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Banana records quick voice notes when you ask it to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Banana looks for photos of meals — only when you turn on Find meal photos automatically — so it can ask what you ate and log it.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Banana reads your reminders on-device so it can schedule tasks onto your day.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Banana transcribes downloaded episodes on your device.</string>
</dict>
</plist>
