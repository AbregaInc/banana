          "unit": "ISO 8601 UTC"
        }
      }
    },
    "calendar_events": {
      "description": "Selected live calendar window. Busy-only records remain redacted. All-day end dates are exclusive.",
      "columns": {
        "id": {
          "type": "string",
          "description": "Projected event ID"
        },
        "title": {
          "type": "string",
          "description": "Shared title or busy label"
        },
        "start": {
          "type": "string",
          "description": "Timed event start, null for all-day",
          "unit": "ISO 8601 UTC"
        },
        "end": {
          "type": "string",
          "description": "Timed event end, null for all-day",
          "unit": "ISO 8601 UTC"
        },
        "start_day": {
          "type": "string",
          "description": "All-day YYYY-MM-DD start"
        },
        "end_day": {
          "type": "string",
          "description": "Exclusive all-day YYYY-MM-DD end"
        },
        "all_day": {
          "type": "boolean",
          "description": "All-day state"
        },
        "calendar": {
          "type": "string",
          "description": "Shared calendar label, nullable for redacted data"
        },
        "location": {
          "type": "string",
          "description": "Shared location, if permitted"
        }
      }
    },
    "assets": {
      "description": "Private source attachments; file_path is populated only for images included in this archive.",
      "columns": {
        "id": {
          "type": "string",
          "description": "Source type:record:field key"
        },
        "record_type": {
          "type": "string",
          "description": "Source record type"
        },
        "record_id": {
          "type": "string",
          "description": "Source record ID"
        },
        "field": {
          "type": "string",
          "description": "Source blob field"
        },
        "url": {
          "type": "string",
          "description": "Private expiring URL"
        },
        "expires_at": {
          "type": "string",
          "description": "URL expiry; null for authenticated session exports or owner preview",
          "unit": "ISO 8601 UTC"
        },
        "file_path": {
          "type": "string",
          "description": "Relative archive path, when downloaded"
        },
        "media_type": {
          "type": "string",
          "description": "Downloaded MIME type, when available"
        }
      }
    }
  },
  "metrics": {
    "sleepHours": "hours",
    "restingHR": "bpm",
    "hrv": "ms",
    "steps": "steps",
    "vo2Max": "mL/kg/min",
    "respiratory": "/min",
    "bodyMassKg": "kg",
    "bodyFatPercentage": "%",
    "activeEnergyKcal": "kcal",
    "exerciseMinutes": "min",
    "walkingHeartRate": "bpm",
    "basalEnergyKcal": "kcal",
    "leanBodyMassKg": "kg",
    "bodyMassIndex": "kg/m²",
    "heightMeters": "m",
    "flightsClimbed": "flights",
    "walkingSpeedMetersPerSecond": "m/s"
  }
}
