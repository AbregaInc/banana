// Who signs the app, and the names only one developer account can own.
//
// These are stand-ins: with them the app builds and runs in a simulator, with iCloud sync and
// Google sign-in switched off. To use your own, copy Local.example.xcconfig to Local.xcconfig
// (not tracked) and fill it in. See README, "Building it yourself".

DEVELOPMENT_TEAM =

// Every bundle id starts with this: the app is exactly this, the Watch app adds .watchkitapp,
// the widgets .widget, the Beta .beta.
BANANA_BUNDLE_ID = org.example.banana

// The private iCloud database the app syncs through. Used only when DEVELOPMENT_TEAM is set.
BANANA_ICLOUD_CONTAINER = iCloud.$(BANANA_BUNDLE_ID)
BANANA_ICLOUD_CONTAINER_BETA = iCloud.$(BANANA_BUNDLE_ID).beta
// A container an earlier app of yours synced through, read once to carry its data over. Empty for none.
BANANA_LEGACY_ICLOUD_CONTAINER =

// Google sign-in: the part of an iOS OAuth client id before ".apps.googleusercontent.com".
// A client id is tied to one bundle id, so each build that has its own bundle id has its own.
// Empty: the app has no Google sign-in.
BANANA_GOOGLE_CLIENT =
BANANA_GOOGLE_CLIENT_BETA =
BANANA_GOOGLE_CLIENT_DEV =

// The Banana service (Service/, docs/design/ACCOUNTS.md): accounts, calendar pushes, usage
// counts. Its host name only (no "https://": xcconfig reads "//" as a comment). Empty: no
// account, and the app counts and sends nothing.
BANANA_SERVICE_HOST =
// The web OAuth client the service trades Google sign-in codes with: the part before
// ".apps.googleusercontent.com", or the whole id. Empty: no account.
BANANA_GOOGLE_SERVER_CLIENT =
// The Beta's own service and web client (Service/wrangler.toml, env beta). Empty: Beta has no account.
BANANA_SERVICE_HOST_BETA =
BANANA_GOOGLE_SERVER_CLIENT_BETA =
BANANA_SERVICE_HOST_DEV =
BANANA_GOOGLE_SERVER_CLIENT_DEV =
BANANA_RELEASE_CHANNEL = stable

// Unreleased modules (`#if BANANA_UNRELEASED`, see AppModules.swift): built into Debug and into
// the author's own installs (tools/ios-install.sh, tools/mac-install.sh pass YES), and left out of
// public Release builds. Stable (TestFlight, the direct download) has neither Email nor local AI;
// only the direct Beta app carries account-gated Email.
// tools/check-release.sh checks the artifact; experimental archives are not public candidates.
BANANA_UNRELEASED = NO
BANANA_UNRELEASED[config=Debug] = YES
// Independent local feature switches. Release defaults to NO; local install scripts can
// opt in with BANANA_UNRELEASED=YES, or set either switch independently.
BANANA_LOCAL_AI = $(BANANA_UNRELEASED)
BANANA_LOCAL_EMAIL = $(BANANA_UNRELEASED)
BANANA_AI_SWIFT_YES = -DBANANA_AI
BANANA_AI_SWIFT_NO =
BANANA_UNRELEASED_SWIFT_YES = -DBANANA_UNRELEASED
BANANA_UNRELEASED_SWIFT_NO = -DBANANA_PUBLIC
OTHER_SWIFT_FLAGS = $(inherited) $(BANANA_UNRELEASED_SWIFT_$(BANANA_LOCAL_EMAIL)) $(BANANA_AI_SWIFT_$(BANANA_LOCAL_AI))

// The modules a build carries (AppModules.swift), each named by its compile condition: a module
// not listed has no code, entitlement, background mode, usage string or embedded target in the
// build (Config/Modules.json, tools/modules/). Plan and the calendar are not modules and are always
// there. Email stays on its own switch above, so every existing way of turning it on still works.
// project.yml adds the list to SWIFT_ACTIVE_COMPILATION_CONDITIONS and to Info.plist
// (BananaModules), where tools/check-release.sh reads it back.
BANANA_MODULE_EMAIL_YES = BANANA_MODULE_EMAIL
BANANA_MODULE_EMAIL_NO =
// Features are carried the same way but are not modules: trip learning ("Learn from my trips",
// Always location and Motion) is Beta's and Stable's, and the App Store app leaves it out.
// Booking (the booking link, its types and pushes) is theirs too: the App Store app is the
// calendar alone.
BANANA_ALL_MODULES = BANANA_MODULE_WORKOUTS BANANA_MODULE_FOOD BANANA_MODULE_NOTES BANANA_MODULE_PODCASTS BANANA_FEATURE_TRIP_LEARNING BANANA_FEATURE_BOOKING $(BANANA_MODULE_EMAIL_$(BANANA_LOCAL_EMAIL))
BANANA_MODULES = $(BANANA_ALL_MODULES)
// The App Store app (configuration AppStore): the calendar alone for its first release. Every
// target of that configuration takes the list, so the widgets compile the same modules as the app.
BANANA_APP_STORE_MODULES =
BANANA_MODULES[config=AppStore] = $(BANANA_APP_STORE_MODULES)
BANANA_UNRELEASED[config=AppStore] = NO
BANANA_LOCAL_EMAIL[config=AppStore] = NO
BANANA_LOCAL_AI[config=AppStore] = NO
BANANA_RELEASE_CHANNEL[config=AppStore] = appstore

// Where the Watch app goes: inside the app, unless the configuration carries none of its modules
// (Config/Generated/Modules.xcconfig, written by tools/modules/modules.py).
BANANA_WATCH_EMBED_PATH = $(CONTENTS_FOLDER_PATH)/Watch
#include? "Generated/Modules.xcconfig"

#include? "Local.xcconfig"
