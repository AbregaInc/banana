#!/bin/zsh
# Refuses a push that would publish private text or a file under private/. Installed once with
# `git config core.hooksPath tools/git-hooks`. Every commit being pushed is checked with
# tools/private-text-check.sh --changes (the files it adds or changes), not only the tip: a scrubbed
# tip with a leaky commit behind it would still publish the leak. A missing deny list refuses the
# push too. Pushing the old history to the private archive needs `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
Z40=0000000000000000000000000000000000000000
REMOTE="${1:-origin}"
result=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$Z40" ]] && continue
    if [[ "$remote_sha" == "$Z40" ]]; then
        range=("$local_sha" --not --remotes="$REMOTE")
    else
        range=("$remote_sha..$local_sha")
    fi
    for sha in $(git rev-list --reverse "${range[@]}"); do
        if [[ -n "$(git ls-tree -r --name-only "$sha" -- private)" ]]; then
            echo "pre-push: $sha ($local_ref) tracks files under private/; nothing was pushed." >&2
            result=1; break
        fi
        if ! tools/private-text-check.sh --changes "$sha"; then
            echo "pre-push: $sha ($local_ref) holds private text; nothing was pushed." >&2
            result=1; break
        fi
    done
done
exit $result
