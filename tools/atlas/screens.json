{
  "about": "Every screen and state of Banana, how to open it with sample data, and where it leads. tools/atlas/capture.py photographs them; tools/atlas/board.py lays them out. '@shell' expands to the tab shell with every sample loaded.",
  "base": [
    "--ui-audit",
    "--disable-icloud",
    "--no-space-sync",
    "--store-capture",
    "-finishSetupDismissed",
    "YES",
    "-onboardingCompleted",
    "YES"
  ],
  "shell": [
    "--ui-preview",
    "--plan",
    "-planMode",
    "day",
    "--dummy-health",
    "--library",
    "--notes",
    "--wellness",
    "--listenmap",
    "--wake-following-sample"
  ],
  "areas": [
    {
      "id": "first-run",
      "title": "First run",
      "summary": "A new install asks what Banana should look after (Plan is always on; Everything ticks the rest), then two questions that build the day (when you wake, when you wind down), then offers Google Calendar. 'Not now' goes straight to Plan; everything skipped waits in the Set up list."
    },
    {
      "id": "plan",
      "title": "Plan",
      "summary": "The first tab. One day or a week of the Google calendar, with Banana's own blocks laid in: routines, reminders, alarms, travel and busy blocks it writes back. A card above the day asks for one thing at a time."
    },
    {
      "id": "events",
      "title": "Events, reminders, alarms",
      "summary": "What the Plan grid opens. Tapping a block opens it; the + or a drag on the grid makes a new one. Every change shows at once and has Undo."
    },
    {
      "id": "workouts",
      "title": "Body · Workouts",
      "summary": "The Body tab holds Workouts, Food and Taken under one switch in the top bar. Workouts come from Apple Health and the Watch; a workout opens to its route, charts and the podcast that played."
    },
    {
      "id": "food",
      "title": "Body · Food",
      "summary": "Meals by photo, words, search, barcode or by hand. Photos wait in 'To log' until they have words; estimates come from the on-device model grounded in USDA and your own scanned foods."
    },
    {
      "id": "taken",
      "title": "Body · Taken",
      "summary": "Supplements and medications: what's due, what was skipped, and timing clashes (e.g. calcium too close to levothyroxine)."
    },
    {
      "id": "notes",
      "title": "Notes",
      "summary": "Voice and written notes. A recording is transcribed on the device."
    },
    {
      "id": "library",
      "title": "Library & player",
      "summary": "Podcasts: shows, episodes, downloads, the player with transcript, notes and up next. Ads can be skipped; the Watch gets downloads."
    },
    {
      "id": "review",
      "title": "Review",
      "summary": "Looking back, behind the chart button at the top left of every tab: fitness trends, sleep, food and listening by week, month or year."
    },
    {
      "id": "routines",
      "title": "Routines & wake",
      "summary": "Routines play something at a moment: a time, before the first meeting, on waking, when a workout starts. Wake & bedtime sets the day's ends."
    },
    {
      "id": "settings",
      "title": "Settings & setup",
      "summary": "Behind '…' on every tab. The Set up list holds every permission still to give, each with its own explainer page."
    },
    {
      "id": "ipad",
      "title": "iPad",
      "summary": "The same app with a sidebar: Review, Routines and Settings are sections instead of sheets, and Food and Taken sit side by side."
    },
    {
      "id": "mac",
      "title": "Mac",
      "summary": "A sidebar app with the same sections; Plan shows Day, 3, 5 days or the week, events open in a drawer, and ⌘K finds any command."
    },
    {
      "id": "watch",
      "title": "Apple Watch",
      "summary": "Start a workout, see it live with the podcast playing, pick a downloaded episode, and the day's agenda."
    }
  ],
