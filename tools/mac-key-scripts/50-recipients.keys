# Cc and Bcc keys, Tab order, completion with the arrow keys and Return (MAIL-UX 4.2.6, 6.3.3)
name recipients
wait 1
key c
wait 1.3
expect firstResponder contains _SystemTextFieldFieldEditor
# completion: type, the list, Down, Return takes the highlighted person
type t
wait 0.6
expect composer.suggestions exists
shot suggestions
key down
expect composer.highlight is 1
key up
expect composer.highlight is 0
key return
wait 0.4
expect composer.to exists
expect composer.toText absent
shot completed
# Shift-Cmd-C and Shift-Cmd-B reveal Cc and Bcc and the caret goes to the new field. A text field's editor
# is not named by the field's own identifier in this tree (the pane's replaces it: `id=mail.pane`), so
# where the caret is shows in where a typed character goes. Punctuation: nobody's name or address has
# any, so nothing is suggested, and Tab then moves on and does not take a suggestion.
key cmd+shift+c
wait 0.8
expect ids contains mail.composer.cc
expect firstResponder contains _SystemTextFieldFieldEditor
type ~
wait 0.2
expect composer.ccText is ~
key cmd+shift+b
wait 0.8
expect ids contains mail.composer.bcc
expect firstResponder contains _SystemTextFieldFieldEditor
type #
wait 0.2
expect composer.bccText is #
shot cc-bcc
# Tab order: To, Cc, Bcc, Subject, body (a character typed at each stop goes into that field; a field
# entered by Tab may select its text, so what was there may be replaced: "contains")
key cmd+shift+o
wait 0.5
expect firstResponder contains _SystemTextFieldFieldEditor
type %
wait 0.2
expect composer.toText is %
key tab
type ^
wait 0.2
expect composer.ccText contains ^
key tab
type *
wait 0.2
expect composer.bccText contains *
key tab
type |
wait 0.2
expect composer.subject contains |
key tab
expect firstResponder contains mail.composer.body
type _
wait 0.2
expect composer.body contains _
shot tab-order
# letters in the subject and in To are text too
refocus subject
type jkesuzrfc
wait 0.2
expect composer.subject is jkesuzrfc
expect mail.counts.inbox is 40
key escape
