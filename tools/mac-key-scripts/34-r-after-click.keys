# R and a word at once after a place in the control column was clicked, so that nothing in the list was
# the last thing touched, at 1120x780: the word is in the reply and the reply is on screen.
name r-after-click
size 1120 780
wait 1
click label:Starred,
wait 0.8
expect mail.place is Starred
expect composer.title absent
shot after-click-on-Starred
type rEach
wait 1.5
expect composer.title is Reply
expect composer.body is Each
expect composer.awaitingCaret is false
expect firstResponder contains mail.composer.body
expect mail.counts.inbox is 40
expect mail.counts.starred is 2
expect toast absent
shot reply-after-click
# the draft is thrown away, and the Inbox is clicked: the place that is already the one shown
key cmd+shift+,
wait 0.8
expect composer.title absent
click label:Inbox,
wait 0.8
expect mail.place is Inbox
type rEach
wait 1.5
expect composer.title is Reply
expect composer.body is Each
expect firstResponder contains mail.composer.body
expect mail.counts.inbox is 40
shot reply-after-click-on-Inbox
key escape
